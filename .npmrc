# Supply-chain hardening: never run dependency install/lifecycle scripts, so a
# compromised (transitive) package can't fire a postinstall hook. CI mirrors this
# with `npm ci --ignore-scripts`.
ignore-scripts=true

# Supply-chain cooldown: only install package versions published more than 7 days
# ago, so a freshly-poisoned release isn't pulled the moment it lands. Matches the
# 7-day Dependabot cooldown in .github/dependabot.yml.
min-release-age=7
