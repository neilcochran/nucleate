{
  "name": "@neilcochran/nucleate",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A comprehensive TypeScript library for molecular biology simulation, modeling the gene expression pathway from DNA transcription to polypeptide translation with biological accuracy.",
  "author": {
    "name": "Neil Cochran",
    "email": "dev.neil.cochran@pm.me",
    "url": "https://github.com/neilcochran"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./coordinates": {
      "types": "./dist/coordinates/index.d.ts",
      "import": "./dist/coordinates/index.js"
    },
    "./sequence": {
      "types": "./dist/sequence/index.d.ts",
      "import": "./dist/sequence/index.js"
    },
    "./pattern": {
      "types": "./dist/pattern/index.d.ts",
      "import": "./dist/pattern/index.js"
    },
    "./gene": {
      "types": "./dist/gene/index.d.ts",
      "import": "./dist/gene/index.js"
    },
    "./variants": {
      "types": "./dist/variants/index.d.ts",
      "import": "./dist/variants/index.js"
    },
    "./transcription": {
      "types": "./dist/transcription/index.d.ts",
      "import": "./dist/transcription/index.js"
    },
    "./splicing": {
      "types": "./dist/splicing/index.d.ts",
      "import": "./dist/splicing/index.js"
    },
    "./polyadenylation": {
      "types": "./dist/polyadenylation/index.d.ts",
      "import": "./dist/polyadenylation/index.js"
    },
    "./modifications": {
      "types": "./dist/modifications/index.d.ts",
      "import": "./dist/modifications/index.js"
    },
    "./processing": {
      "types": "./dist/processing/index.d.ts",
      "import": "./dist/processing/index.js"
    },
    "./translation": {
      "types": "./dist/translation/index.d.ts",
      "import": "./dist/translation/index.js"
    },
    "./replication": {
      "types": "./dist/replication/index.d.ts",
      "import": "./dist/replication/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint --ext .ts --fix . && cspell lint --unique --words-only \"src/**/*\"",
    "lint:fix": "eslint --ext .ts --fix .",
    "lint:check": "eslint --ext .ts . && cspell lint --unique --words-only \"src/**/*\"",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "knip": "knip",
    "lint:pack": "publint",
    "attw": "attw --pack --profile esm-only",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doc": "rimraf docs/ && typedoc --includeVersion --out docs src/",
    "build": "npm run lint && rimraf dist/ && tsc",
    "clean": "rimraf dist/ docs/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilcochran/nucleate.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cspell": "^10.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tsdoc": "^0.5.2",
    "jest": "^29.7.0",
    "knip": "^6.16.1",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dna",
    "rna",
    "nucleic",
    "nucleic acid",
    "amino",
    "amino acid",
    "polypeptide",
    "genetics"
  ],
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false
}
